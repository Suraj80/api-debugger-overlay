{
  "manifest_version": 3,
  "name": "API Debugger Overlay",
  "version": "1.0.0",
  "description": "Real-time API debugging directly on any webpage",

  "permissions": ["storage", "scripting", "activeTab", "sidePanel", "webRequest", "downloads"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/index.tsx"],
    "run_at": "document_start"
  }],

  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": { "32": "icons/icon32.png" }
  },

  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },

  "web_accessible_resources": [{
    "resources": ["src/injected/index.js"],
    "matches": ["<all_urls>"]
  }]
}
